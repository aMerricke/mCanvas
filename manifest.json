{
  "manifest_version": 3,
  "name": "Simple Canvas",
  "version": "0.1.0",
  "description": "A small visual enhancement for the UMD Canvas dashboard.",
  "content_scripts": [
    {
      "matches": [
        "https://umd.instructure.com/*"
      ],
      "css": [
        "src/dashboard.css"
      ],
      "run_at": "document_start"
    }
  ]
}
