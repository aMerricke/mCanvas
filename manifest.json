{
  "manifest_version": 3,
  "name": "mCanvas",
  "version": "0.1.0",
  "description": "Assignment tracker and decluttering tools for the Canvas LMS.",
  "icons": {
    "16": "icons/mcanvas-icon-16.png",
    "32": "icons/mcanvas-icon-32.png",
    "48": "icons/mcanvas-icon-48.png",
    "128": "icons/mcanvas-icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "css": [
        "src/sidebar.css",
        "src/canvas.css"
      ],
      "js": [
        "src/state.js",
        "src/storage.js",
        "src/canvas-api.js",
        "src/canvas.js"
      ],
      "run_at": "document_start"
    }
  ]
}
