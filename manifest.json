{
  "manifest_version": 3,
  "name": "mCanvas",
  "version": "0.1.0",
  "description": "Assignment tracker and customization tools for Canvas LMS.",
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*"
      ],
      "css": [
        "src/canvas.css"
      ],
      "run_at": "document_start"
    }
  ]
}
